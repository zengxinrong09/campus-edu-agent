# ===== 对话模型：硅基流动 SiliconFlow（server/index.js）=====
SILICONFLOW_API_KEY=
# 可选，留空使用默认值 Qwen/Qwen3-8B
SILICONFLOW_MODEL=Qwen/Qwen3-8B
# 可选，1 = 开启 Qwen3 思考模式（默认关闭）
SILICONFLOW_ENABLE_THINKING=0
# 可选，主模型触发 TPM 限流时自动降级的备用模型（写 off 关闭降级）
SILICONFLOW_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct

# ===== 知识库 Embedding：阿里云百炼（server/mcp-server.js）=====
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v3

SERVER_PORT=8787
